=== on-chain/src/GiftCard/MintingPolicy.hs ===
module GiftCard.MintingPolicy (
  PGiftCardAction (..),
  pgiftCardPolicy,
) where

import GHC.Generics (Generic)
import Generics.SOP qualified as SOP
import GiftCard.Utils (pcheck, pmintsExactly)
import Plutarch.LedgerApi.V3 (
  PScriptContext (..),
  PScriptInfo (PMintingScript),
  PTokenName,
  PTxInInfo (..),
  PTxInfo (..),
  PTxOutRef,
 )
import Plutarch.Prelude

{- | Redeemer for the gift-card minting policy: mint the one-shot token, or
burn it. 'DeriveAsDataStruct' encodes it as @Constr 0 []@ / @Constr 1 []@,
the same shape every off-chain template sends.
-}
data PGiftCardAction (s :: S) = PMint | PBurn
  deriving stock (Generic)
  deriving anyclass (SOP.Generic, PIsData)
  deriving (PlutusType, PValidateData) via (DeriveAsDataStruct PGiftCardAction)

{- | One-shot minting policy, parameterised by the gift-card token name and a
seed UTxO. Minting requires the seed UTxO to be spent (so the policy id is
unique) and mints exactly one token of the given name; burning requires
exactly one to be burned.

The two parameters are left free: off-chain code applies them to the compiled
script with @applyParamsToScript@, so every gift card gets a fresh policy id.
-}
pgiftCardPolicy ::
  forall (s :: S).
  Term s (PAsData PTokenName :--> PAsData PTxOutRef :--> PAsData PScriptContext :--> PUnit)
pgiftCardPolicy = plam $ \tokenName seed ctxData ->
  pmatch (pfromData ctxData) $ \ctx ->
    pmatch (pscriptContext'scriptInfo ctx) $ \case
      PMintingScript ownPolicy ->
        pmatch (pscriptContext'txInfo ctx) $ \txInfo ->
          let mintsOwn amount =
                pmintsExactly
                  # pfromData ownPolicy
                  # pfromData tokenName
                  # amount
                  # pfromData (ptxInfo'mint txInfo)
              seedSpent =
                pany
                  # plam (\input -> pmatch (pfromData input) $ \i -> pdata (ptxInInfo'outRef i) #== seed)
                  # pfromData (ptxInfo'inputs txInfo)
              -- The redeemer comes from the transaction builder, so check its shape.
              action = pfromData (pparseData @PGiftCardAction (pto (pscriptContext'redeemer ctx)))
           in pmatch action $ \case
                PMint -> pcheck "gift_card: seed not spent or not exactly one token minted" (seedSpent #&& mintsOwn 1)
                PBurn -> pcheck "gift_card: not exactly one token burned" (mintsOwn (-1))
      _ -> ptraceInfoError "gift_card: not a minting script"

=== on-chain/src/GiftCard/Redeem.hs ===
module GiftCard.Redeem (predeemValidator) where

import GiftCard.Utils (pcheck, pmintsExactly)
import Plutarch.LedgerApi.V3 (
  PCurrencySymbol,
  PScriptContext (..),
  PTokenName,
  PTxInfo (..),
 )
import Plutarch.Prelude

{- | Spending validator guarding the gift locked at its address, parameterised
by the gift-card token name and the gift-card policy id. The UTxO can only be
spent when exactly that one token is burned in the same transaction. The datum
and redeemer are unused: burning the token is the authorisation.
-}
predeemValidator ::
  forall (s :: S).
  Term s (PAsData PTokenName :--> PAsData PCurrencySymbol :--> PAsData PScriptContext :--> PUnit)
predeemValidator = plam $ \tokenName policy ctxData ->
  pmatch (pfromData ctxData) $ \ctx ->
    pmatch (pscriptContext'txInfo ctx) $ \txInfo ->
      pcheck "redeem: gift-card token not burned" $
        pmintsExactly
          # pfromData policy
          # pfromData tokenName
          # (-1)
          # pfromData (ptxInfo'mint txInfo)

=== on-chain/src/GiftCard/Scripts.hs ===
-- | The validators compiled to Plutus Core, ready to serialise or evaluate.
module GiftCard.Scripts (giftCardScript, redeemScript) where

import Data.Text qualified as Text
import GiftCard.MintingPolicy (pgiftCardPolicy)
import GiftCard.Redeem (predeemValidator)
import Plutarch.Internal.Term (Config (NoTracing), compile)
import Plutarch.Prelude
import Plutarch.Script (Script)

-- | The gift-card minting policy, with its two parameters still unapplied.
giftCardScript :: Script
giftCardScript = compileOrFail "gift_card" pgiftCardPolicy

-- | The redeem spending validator, with its two parameters still unapplied.
redeemScript :: Script
redeemScript = compileOrFail "redeem" predeemValidator

{- | Compile without tracing, which keeps the scripts small. Switch to
@Tracing LogInfo DetTracing@ to keep the @ptraceInfo*@ messages while debugging.
-}
compileOrFail :: String -> (forall (s :: S). Term s a) -> Script
compileOrFail name term = case compile NoTracing term of
  Left err -> error ("failed to compile " <> name <> ": " <> Text.unpack err)
  Right script -> script

=== on-chain/src/GiftCard/Types.hs ===
{-# LANGUAGE TemplateHaskell #-}

-- | Haskell-side mirrors of the on-chain types. They describe the wire format
-- in the CIP-57 blueprint and let tests build redeemers in that same format.
module GiftCard.Types (GiftCardAction (..)) where

import GHC.Generics (Generic)
import PlutusTx (makeIsDataSchemaIndexed)
import PlutusTx.Blueprint (HasBlueprintDefinition)

{- | Redeemer for the gift-card minting policy: mint the one-shot token, or burn
it. Encoded as @Constr 0 []@ / @Constr 1 []@, matching 'GiftCard.MintingPolicy.PGiftCardAction'.
-}
data GiftCardAction = Mint | Burn
  deriving stock (Generic)
  deriving anyclass (HasBlueprintDefinition)

makeIsDataSchemaIndexed ''GiftCardAction [('Mint, 0), ('Burn, 1)]

=== on-chain/src/GiftCard/Utils.hs ===
module GiftCard.Utils (pcheck, pmintsExactly) where

import Plutarch.LedgerApi.AssocMap qualified as AssocMap
import Plutarch.LedgerApi.V3 (PCurrencySymbol, PMintValue, PTokenName)
import Plutarch.Prelude

{- | True when the minted value holds exactly one entry under @policy@: the
token @tokenName@ with quantity @amount@ (@1@ to mint it, @-1@ to burn it).
Any other token of the same policy in the transaction makes it false.
-}
pmintsExactly ::
  forall (s :: S).
  Term s (PCurrencySymbol :--> PTokenName :--> PInteger :--> PMintValue :--> PBool)
pmintsExactly = phoistAcyclic $
  plam $ \policy tokenName amount mint ->
    pmatch (AssocMap.plookup # policy # pto (pto mint)) $ \case
      PNothing -> pconstant False
      PJust tokens -> tokens #== AssocMap.psingleton # tokenName # amount

-- | Succeed with unit when the condition holds, otherwise fail with a trace.
pcheck :: forall (s :: S). Term s PString -> Term s PBool -> Term s PUnit
pcheck message condition = pif condition (pconstant ()) (ptraceInfoError message)

=== on-chain/app/GenBlueprint.hs ===
module Main (main) where

import Data.ByteString.Short qualified as Short
import Data.Set qualified as Set
import GiftCard.Scripts (giftCardScript, redeemScript)
import GiftCard.Types (GiftCardAction)
import Plutarch.Script (Script, serialiseScript)
import PlutusLedgerApi.V3 (TxId, TxOutRef)
import PlutusTx.Blueprint
import PlutusTx.Builtins (BuiltinByteString, BuiltinData)
import System.Environment (getArgs)

{- | The combined CIP-57 blueprint: one contract exposing the gift-card minting
policy and its redeem spending validator. Both are emitted parameterised
(their arguments are left free), so any off-chain component can apply a token
name and seed UTxO / policy id and get working scripts.
-}
contractBlueprint :: ContractBlueprint
contractBlueprint =
  MkContractBlueprint
    { contractId = Just "gift-card"
    , contractPreamble = preamble
    , contractValidators = Set.fromList [giftCardValidator, redeemValidator]
    , contractDefinitions =
        deriveDefinitions @[GiftCardAction, TxOutRef, TxId, BuiltinByteString, Integer, BuiltinData]
    }

preamble :: Preamble
preamble =
  MkPreamble
    { preambleTitle = "snap-project gift card"
    , preambleDescription =
        Just "One-shot gift-card minting policy and its redeem spending validator"
    , preambleVersion = "1.0.0"
    , preamblePlutusVersion = PlutusV3
    , preambleLicense = Just "Apache-2.0"
    }

-- | The script bytes as the blueprint expects them (CBOR-wrapped flat UPLC).
compiledBytes :: Script -> CompiledValidator
compiledBytes = compiledValidator PlutusV3 . Short.fromShort . serialiseScript

{- | The minting policy. Its title ends in @gift_card.mint@ so off-chain tools
can find it in the blueprint by convention.
-}
giftCardValidator :: ValidatorBlueprint referencedTypes
giftCardValidator =
  MkValidatorBlueprint
    { validatorTitle = "giftcard.gift_card.mint"
    , validatorDescription =
        Just "One-shot minting policy: mints a unique gift-card token; burns it on redeem"
    , validatorParameters =
        [ MkParameterBlueprint
            { parameterTitle = Just "Token name"
            , parameterDescription = Just "Name of the gift-card token"
            , parameterPurpose = Set.singleton Mint
            , parameterSchema = definitionRef @BuiltinByteString
            }
        , MkParameterBlueprint
            { parameterTitle = Just "Seed UTxO"
            , parameterDescription = Just "Output reference spent when minting, guaranteeing uniqueness"
            , parameterPurpose = Set.singleton Mint
            , parameterSchema = definitionRef @TxOutRef
            }
        ]
    , validatorRedeemer =
        MkArgumentBlueprint
          { argumentTitle = Just "Action"
          , argumentDescription = Just "Mint the gift-card token or burn it"
          , argumentPurpose = Set.fromList [Mint]
          , argumentSchema = definitionRef @GiftCardAction
          }
    , validatorDatum = Nothing
    , validatorCompiled = Just (compiledBytes giftCardScript)
    }

-- | The redeem spending validator. Its title ends in @redeem.spend@.
redeemValidator :: ValidatorBlueprint referencedTypes
redeemValidator =
  MkValidatorBlueprint
    { validatorTitle = "giftcard.redeem.spend"
    , validatorDescription =
        Just "Guards the locked gift; releases the assets when the gift-card token is burned"
    , validatorParameters =
        [ MkParameterBlueprint
            { parameterTitle = Just "Token name"
            , parameterDescription = Just "Name of the gift-card token"
            , parameterPurpose = Set.singleton Spend
            , parameterSchema = definitionRef @BuiltinByteString
            }
        , MkParameterBlueprint
            { parameterTitle = Just "Policy id"
            , parameterDescription = Just "Currency symbol of the gift-card minting policy"
            , parameterPurpose = Set.singleton Spend
            , parameterSchema = definitionRef @BuiltinByteString
            }
        ]
    , validatorRedeemer =
        MkArgumentBlueprint
          { argumentTitle = Just "Redeemer"
          , argumentDescription = Just "Unused; burning the token in the same transaction authorises the spend"
          , argumentPurpose = Set.fromList [Spend]
          , argumentSchema = definitionRef @BuiltinData
          }
    , validatorDatum = Nothing
    , validatorCompiled = Just (compiledBytes redeemScript)
    }

main :: IO ()
main =
  getArgs >>= \case
    [path] -> writeBlueprint path contractBlueprint
    args -> fail $ "Expects one argument (output path), got " <> show (length args)

=== on-chain/test/Spec.hs ===
{- | Behaviour tests for the gift-card validators. Each case builds a script
context the way the ledger would, applies the parameters and context to the
compiled script exactly as an off-chain tool does, and evaluates it.
-}
module Main (main) where

import GiftCard.Scripts (giftCardScript, redeemScript)
import GiftCard.Types (GiftCardAction (Burn, Mint))
import Plutarch.Evaluate (applyArguments, evalScript)
import Plutarch.Script (Script)
import PlutusLedgerApi.V3
import PlutusLedgerApi.V3.MintValue (MintValue (UnsafeMintValue))
import PlutusTx.AssocMap qualified as Map
import PlutusTx.Builtins (dataToBuiltinData)
import Test.Tasty (TestTree, defaultMain, testGroup)
import Test.Tasty.HUnit (assertBool, testCase)

main :: IO ()
main =
  defaultMain $
    testGroup
      "gift card"
      [ testGroup
          "gift_card minting policy"
          [ accepts "mints one token when the seed is spent" $
              runGiftCard (redeemer Mint) [seed] (mintOf policy [(giftName, 1)])
          , rejects "minting without spending the seed" $
              runGiftCard (redeemer Mint) [otherRef] (mintOf policy [(giftName, 1)])
          , rejects "minting two tokens" $
              runGiftCard (redeemer Mint) [seed] (mintOf policy [(giftName, 2)])
          , rejects "minting a token with another name" $
              runGiftCard (redeemer Mint) [seed] (mintOf policy [("OTHER", 1)])
          , rejects "minting an extra token under the same policy" $
              runGiftCard (redeemer Mint) [seed] (mintOf policy [(giftName, 1), ("OTHER", 1)])
          , accepts "burns one token" $
              runGiftCard (redeemer Burn) [otherRef] (mintOf policy [(giftName, -1)])
          , rejects "burn redeemer while minting" $
              runGiftCard (redeemer Burn) [seed] (mintOf policy [(giftName, 1)])
          , rejects "a malformed redeemer" $
              runGiftCard (dataToBuiltinData (Constr 2 [])) [seed] (mintOf policy [(giftName, 1)])
          ]
      , testGroup
          "redeem spending validator"
          [ accepts "spends when the gift-card token is burned" $
              runRedeem (mintOf policy [(giftName, -1)])
          , rejects "spending without burning" $
              runRedeem (UnsafeMintValue Map.empty)
          , rejects "burning a token of another policy" $
              runRedeem (mintOf otherPolicy [(giftName, -1)])
          , rejects "minting instead of burning" $
              runRedeem (mintOf policy [(giftName, 1)])
          ]
      ]

accepts :: String -> Bool -> TestTree
accepts name result = testCase name (assertBool "expected the script to succeed" result)

rejects :: String -> Bool -> TestTree
rejects name result = testCase ("rejects " <> name) (assertBool "expected the script to fail" (not result))

-- | Apply the arguments to a compiled script and report whether it succeeds.
succeeds :: Script -> [Data] -> Bool
succeeds script args = case evalScript (applyArguments script args) of
  (Right _, _, _) -> True
  (Left _, _, _) -> False

-- | Run the minting policy with the given redeemer, spent inputs and mint value.
runGiftCard :: BuiltinData -> [TxOutRef] -> MintValue -> Bool
runGiftCard action spent mint =
  succeeds
    giftCardScript
    [ toData giftName
    , toData seed
    , toData (ScriptContext (txInfo spent mint) (Redeemer action) (MintingScript policy))
    ]

-- | Run the redeem validator against a transaction with the given mint value.
runRedeem :: MintValue -> Bool
runRedeem mint =
  succeeds
    redeemScript
    [ toData giftName
    , toData policy
    , toData (ScriptContext (txInfo [giftRef] mint) (Redeemer (toBuiltinData ())) (SpendingScript giftRef Nothing))
    ]

redeemer :: GiftCardAction -> BuiltinData
redeemer = toBuiltinData

giftName :: BuiltinByteString
giftName = "GIFT"

seed, otherRef, giftRef :: TxOutRef
seed = TxOutRef (TxId "seed-tx-0123456789abcdef01234567") 0
otherRef = TxOutRef (TxId "other-tx-0123456789abcdef0123456") 0
giftRef = TxOutRef (TxId "gift-tx-0123456789abcdef01234567") 0

policy, otherPolicy :: CurrencySymbol
policy = CurrencySymbol "gift-card-policy-0123456789a"
otherPolicy = CurrencySymbol "another-policy-0123456789abc"

-- | A mint value holding the given (token name, quantity) entries under one policy.
mintOf :: CurrencySymbol -> [(BuiltinByteString, Integer)] -> MintValue
mintOf cs tokens =
  UnsafeMintValue (Map.unsafeFromList [(cs, Map.unsafeFromList [(TokenName tn, q) | (tn, q) <- tokens])])

-- | A transaction spending the given outputs and minting the given value.
txInfo :: [TxOutRef] -> MintValue -> TxInfo
txInfo spent mint =
  TxInfo
    { txInfoInputs = map input spent
    , txInfoReferenceInputs = []
    , txInfoOutputs = []
    , txInfoFee = Lovelace 200_000
    , txInfoMint = mint
    , txInfoTxCerts = []
    , txInfoWdrl = Map.empty
    , txInfoValidRange = always
    , txInfoSignatories = []
    , txInfoRedeemers = Map.empty
    , txInfoData = Map.empty
    , txInfoId = TxId "this-tx-0123456789abcdef01234567"
    , txInfoVotes = Map.empty
    , txInfoProposalProcedures = []
    , txInfoCurrentTreasuryAmount = Nothing
    , txInfoTreasuryDonation = Nothing
    }
  where
    input ref =
      TxInInfo ref (TxOut (Address (PubKeyCredential (PubKeyHash "owner-key-hash-0123456789ab")) Nothing) mempty NoOutputDatum Nothing)

=== on-chain/flake.nix ===
{
  description = "snap-project — on-chain (Plutarch) component";

  inputs = {
    haskell-nix = {
      url = "github:input-output-hk/haskell.nix";
      inputs.hackage.follows = "hackage";
    };

    nixpkgs.follows = "haskell-nix/nixpkgs";

    hackage = {
      url = "github:input-output-hk/hackage.nix";
      flake = false;
    };

    CHaP = {
      url = "github:IntersectMBO/cardano-haskell-packages?ref=repo";
      flake = false;
    };

    iohk-nix = {
      url = "github:input-output-hk/iohk-nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };

    flake-utils.url = "github:numtide/flake-utils";
  };

  outputs = inputs: inputs.flake-utils.lib.eachDefaultSystem (system:
    import ./nix/outputs.nix { inherit inputs system; }
  );

  nixConfig = {
    extra-substituters = [
      "https://cache.iog.io"
      "https://cache.zw3rk.com"
    ];
    extra-trusted-public-keys = [
      "hydra.iohk.io:f/Ea+s+dFdN+3Y/G+FDgSq+a5NEWhJGzdjvKNGv0/EQ="
      "loony-tools:pr9m4BkM/5/eSTZlkQyRt57Jz7OMBxNSUiMC4FkcNfk="
    ];
    allow-import-from-derivation = true;
    accept-flake-config = true;
  };
}

