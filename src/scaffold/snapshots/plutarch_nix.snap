=== on-chain/nix/outputs.nix ===
{ inputs, system }:

let
  inherit (pkgs) lib;

  pkgs = import ./pkgs.nix { inherit inputs system; };

  project = import ./project.nix { inherit inputs pkgs lib; };

  mkShell = withDevTools: import ./shell.nix { inherit pkgs lib project withDevTools; };

in

{
  # GHC, the prebuilt Haskell dependencies, cabal, and editor/lint tooling.
  devShells.default = mkShell true;

  # Toolchain only: no language server or linters, which build from source.
  # Used by CI (`nix develop .#minimal`).
  devShells.minimal = mkShell false;
}

=== on-chain/nix/pkgs.nix ===
{ inputs, system }:

import inputs.nixpkgs {
  inherit system;
  config = inputs.haskell-nix.config;
  overlays = [
    inputs.iohk-nix.overlays.crypto
    inputs.iohk-nix.overlays.cardano-lib
    inputs.haskell-nix.overlay
    inputs.iohk-nix.overlays.haskell-nix-crypto
    inputs.iohk-nix.overlays.haskell-nix-extra
  ];
}

=== on-chain/nix/project.nix ===
{ inputs, pkgs, lib }:

pkgs.haskell-nix.cabalProject' {
  name = "snap-project";

  # Plutarch 1.15 is built and tested upstream with GHC 9.8.
  compiler-nix-name = lib.mkDefault "ghc984";

  src = lib.cleanSource ../.;

  inputMap = { "https://chap.intersectmbo.org/" = inputs.CHaP; };

  # Skip Haddock for every dependency; it roughly doubles the first build.
  modules = [{ doHaddock = false; }];
}

=== on-chain/nix/shell.nix ===
{ pkgs, lib, project, withDevTools }:

project.shellFor {
  name = "plutarch-${project.args.compiler-nix-name}";

  withHoogle = false;
  exactDeps = false;

  tools = {
    cabal = "latest";
  } // lib.optionalAttrs withDevTools {
    haskell-language-server = "latest";
    hlint = "latest";
    fourmolu = "latest";
    cabal-fmt = "latest";
  };

  # cabal fetches the pinned Plutarch source-repository-package with git.
  buildInputs = [ pkgs.git ];
}

=== spec/README.md ===
# Protocol specification

This folder holds the **specification** of snap-project: what the protocol
does and why it is safe, written as plain text (Markdown) for people to read.
Nothing in it is executed or built.

Use it to design a change before writing validators, and to review changes
against: if the code and the spec disagree, one of them is wrong.

## Conventions

- One document per protocol or feature (e.g. `giftcard.md`). Add new ones next
  to it and list them below.
- Each document describes **actors**, **assets**, **validators** (parameters,
  datum, redeemer, and the rules they enforce), **transactions** (inputs,
  outputs, mint), and the **invariants** the protocol must keep.
- Keep the spec in step with the code: a pull request that changes a validator
  updates its spec in the same change.
- Formal, machine-checked specifications belong to the formal-methods
  component, not here. This folder is the human-readable source of intent.

## Documents

- [`giftcard.md`](giftcard.md): the gift-card example protocol shipped with the
  generated project. Replace it with your own protocol's spec.

=== spec/giftcard.md ===
# Gift card protocol

> Example specification for the gift-card protocol shipped with this project.
> Replace it with the specification of your own protocol.

## Overview

A **giver** locks assets (the gift) at a script address together with a
unique **gift-card token**. Anyone can **redeem** the gift by spending that UTxO
in a transaction that burns the token. The validators guarantee that each gift
card is unique and that the locked value is released only by burning its
token. They do not restrict *who* redeems it.

## Actors

| Actor     | Role                                                                     |
|-----------|--------------------------------------------------------------------------|
| Giver     | Creates the gift card: funds the gift and mints the token.               |
| Redeemer  | Spends the locked UTxO, burns the token, and receives the gift.          |

## Assets

- **Gift-card token**: a single native token under the `gift_card` minting
  policy.
  - Its asset name is the `token_name` parameter.
  - Its policy id is the hash of `gift_card` applied to its parameters, so each
    gift card has its own policy.
- **Gift**: the assets (typically lovelace) locked at the `redeem` script
  address next to the token.

## Validators

### `gift_card` (minting policy)

Parameters:
- `token_name: ByteArray`: the asset name of the gift-card token.
- `utxo_ref: OutputReference`: the seed UTxO, which must be spent when minting.

Redeemer: `Action = Mint | Burn` (`Mint` = constructor 0, `Burn` = constructor 1).

Rules. In both cases, exactly one asset of this policy is minted or burned in
the transaction.

| Redeemer | Must hold                                                                           |
|----------|-------------------------------------------------------------------------------------|
| `Mint`   | `utxo_ref` is among the inputs, and exactly `+1` of `token_name` is minted.         |
| `Burn`   | Exactly `-1` of `token_name` is burned.                                             |

### `redeem` (spending validator)

Parameters:
- `token_name: ByteArray`: the gift-card token's asset name.
- `policy_id: ByteArray`: the `gift_card` policy id for this gift card.

Datum and redeemer: unused on-chain. Off-chain code attaches an inline datum
`[seed_tx_hash, seed_output_index, token_name]` so the gift card's parameters
can be recovered from the UTxO. The redeemer is unit.

Rule: the locked UTxO can be spent only if the same transaction burns exactly
`-1` of `token_name` under `policy_id`, and nothing else under that policy.

## Transactions

### Create

| | |
|---|---|
| Inputs  | The giver's seed UTxO (`utxo_ref`), plus any funding UTxOs. |
| Mint    | `+1` `token_name` under `gift_card(token_name, utxo_ref)`, redeemer `Mint`. |
| Outputs | The gift **and** the token, locked at the address of `redeem(token_name, policy_id)` with the inline datum above. |

### Redeem

| | |
|---|---|
| Inputs  | The UTxO locked at the `redeem` address (it carries the token). |
| Mint    | `-1` `token_name` under the same policy, redeemer `Burn`. |
| Outputs | The released gift to the redeemer's address. |

## Invariants

1. **Uniqueness.** At most one gift-card token ever exists per policy. Minting
   requires spending `utxo_ref`, and a UTxO can be spent only once.
2. **Funds move only by redemption.** Value at the `redeem` address leaves only
   in a transaction that burns that gift card's token.
3. **Burn exactly once.** A redemption burns exactly one token. Minting or
   burning any other amount or name under the policy fails.
4. **Isolation.** Each gift card's policy is parameterised by its own seed, so
   tokens and locked funds of different gift cards cannot be confused.

## Out of scope

- Expiry or reclaim by the giver (the gift is locked until redeemed).
- Partial redemption.
- Restricting who may redeem. The token is locked with the gift, so anyone who
  finds the UTxO can claim it. A real protocol would add, for example, a
  recipient signature check or send the token to the recipient's wallet.

## Implementation

- Validators: `on-chain/` (Plutarch).
- Compiled validators: `blueprint/plutus.json` (CIP-57 blueprint).

=== flake.nix ===
{
  description = "snap-project — Cardano protocol project";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";
    flake-utils.url = "github:numtide/flake-utils";
    "on-chain".url = "path:./on-chain";
  };

  outputs = { self, nixpkgs, flake-utils, ... }@inputs:
    flake-utils.lib.eachDefaultSystem (system:
      let
        pkgs = nixpkgs.legacyPackages.${system};

        # `shell` picks which dev shell to compose from components that ship
        # their own flake: "default" (with editor/lint tooling) or "minimal".
        mkShell = shell: pkgs.mkShell {
          name = "snap-project";

          # Compose the dev shells of components that ship their own flake (e.g.
          # the Plinth on-chain haskell.nix shell) so their full toolchain — and
          # `just build` for them — works from the project root.
          inputsFrom = [
            inputs."on-chain".devShells.${system}.${shell}
          ];

          buildInputs = with pkgs; [
            just
          ];

          shellHook = ''
            echo "snap-project dev shell"
            echo "Run 'just' to see available tasks."
          '';
        };
      in
      {
        devShells.default = mkShell "default";

        # Toolchains only, without language servers or linters that build from
        # source. Used by CI: `nix develop .#minimal`.
        devShells.minimal = mkShell "minimal";
      });

  # A composed component uses haskell.nix (IOG's Cardano toolchain), which is
  # served prebuilt from these caches. Without them the shell builds GHC and the
  # Plutus stack from source. `accept-flake-config` lets direnv/nix use them.
  nixConfig = {
    extra-substituters = [
      "https://cache.iog.io"
      "https://cache.zw3rk.com"
    ];
    extra-trusted-public-keys = [
      "hydra.iohk.io:f/Ea+s+dFdN+3Y/G+FDgSq+a5NEWhJGzdjvKNGv0/EQ="
      "loony-tools:pr9m4BkM/5/eSTZlkQyRt57Jz7OMBxNSUiMC4FkcNfk="
    ];
    allow-import-from-derivation = true;
    accept-flake-config = true;
  };
}

=== .envrc ===
# A composed component flake (haskell.nix) declares extra binary caches in its
# nixConfig. Pre-accept it so `direnv allow` and nix run non-interactively — no
# y/N trust prompt — which matters for CI and agents. This only silences the
# prompt; whether those caches are actually used still depends on the machine
# trusting them (a trusted Nix user, or the substituters in the system
# nix.conf). Untrusted users simply skip them and fall back to their configured
# caches (e.g. a system-wide cache.iog.io) or build from source.
export NIX_CONFIG="accept-flake-config = true"

# If this machine doesn't trust the IOG binary cache, the Haskell toolchain
# (GHC, HLS, the Plutus stack) is built from source on first entry — which can
# take a very long time. Warn up front so a long silent wait isn't a surprise.
if ! { nix config show 2>/dev/null || nix show-config 2>/dev/null; } | grep -Eq '^substituters =.*cache\.iog\.io'; then
  echo "[snap-project] cache.iog.io is not a trusted substituter on this machine — the Haskell toolchain will build from source, which can take a very long time." >&2
  echo "[snap-project] To use prebuilt binaries: become a trusted Nix user, or add the substituters/keys from on-chain/flake.nix (nixConfig) to your system nix.conf, then reload." >&2
fi
use flake

