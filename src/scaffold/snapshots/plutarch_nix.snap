=== blueprint/.gitkeep ===

=== on-chain/Justfile ===
# On-chain component (Plutarch)
# Part of snap-project
#
# Plutarch is a typed language embedded in Haskell for writing validators with
# fine control over the generated Plutus Core. `build` runs the blueprint
# generator, which serialises the compiled validators into the CIP-57 blueprint
# at ../blueprint/plutus.json for the off-chain / devnet / formal components to consume.
#
# Plutus comes from IOG's package repository (CHaP) and Plutarch from its git
# repository, both configured in cabal.project. The first build needs a package
# index, so `build` runs `cabal update` for you; it's a fast no-op once current.

# Compile the validators and write the CIP-57 blueprint to ../blueprint/plutus.json.
build: _check-ghc
    @cabal update
    @cabal build all
    @cabal run -v0 gen-blueprint -- ../blueprint/plutus.json

# Run the behaviour tests: each validator is evaluated against hand-built
# script contexts that should succeed or fail.
test: _check-ghc
    @cabal test all

clean:
    @cabal clean
    @rm -f ../blueprint/plutus.json

# Plutarch 1.15 is built and tested upstream with GHC 9.8; fail early with a
# clear message instead of deep inside a dependency build.
_check-ghc:
    @ghc --numeric-version 2>/dev/null | grep -q '^9\.8\.' || { echo "Plutarch needs GHC 9.8.x (found: $(ghc --numeric-version 2>/dev/null || echo none)). Install it with: ghcup install ghc 9.8.4"; exit 1; }

=== on-chain/onchain.cabal ===
cabal-version:   3.0
name:            onchain
version:         0.1.0.0
license:
build-type:      Simple

common lang
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DeriveAnyClass
    DerivingStrategies
    DerivingVia
    LambdaCase
    OverloadedStrings
    TypeFamilies
    UndecidableInstances
    ViewPatterns

  ghc-options:        -Wall

common plutus-deps
  build-depends:
    , plutarch             ^>=1.15.0
    , plutarch-ledger-api  ^>=3.8.0
    , plutus-core          ==1.71.0.0
    , plutus-ledger-api
    , plutus-tx

-- The validators, written in Plutarch, and their compiled scripts.
library
  import:          lang, plutus-deps
  hs-source-dirs:  src
  build-depends:
    , base
    , generics-sop
    , text

  exposed-modules:
    GiftCard.MintingPolicy
    GiftCard.Redeem
    GiftCard.Scripts
    GiftCard.Types
    GiftCard.Utils

-- Serialises the compiled validators into a single CIP-57 blueprint.
executable gen-blueprint
  import:         lang, plutus-deps
  hs-source-dirs: app
  main-is:        GenBlueprint.hs
  build-depends:
    , base
    , bytestring
    , containers
    , onchain

-- Behaviour tests: run the compiled scripts against hand-built script contexts.
test-suite onchain-test
  import:         lang, plutus-deps
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  build-depends:
    , base
    , onchain
    , tasty
    , tasty-hunit

