# Off-chain secrets for submitting transactions.
# Copy this file to `.env.local` (gitignored) and fill in the values.
# CARDANO_NETWORK and the connection details (INDEXER_URL, OGMIOS_URL,
# DOLOS_GRPC_URL) are read from the shared ../.env. Settings in .env.local
# override ../.env, and non-empty environment variables override both.

# Where transactions go is decided by ../.env, not here:
#   • INDEXER_URL set by a local devnet (Yaci DevKit's `just dev`) or a
#     Blockfrost-compatible indexer (Dingo) → that endpoint is used.
#   • OGMIOS_URL set (Ogmios infra, with Kupo at INDEXER_URL) → Ogmios + Kupo.
#   • DOLOS_GRPC_URL set (Dolos infra) → UTxO RPC.
#   • none of the above → Blockfrost, and BLOCKFROST_PROJECT_ID is required.

# Blockfrost project id for your target network — https://blockfrost.io
# Only needed when no local endpoint is configured.
BLOCKFROST_PROJECT_ID=

# Mnemonic (space-separated words) of the wallet that funds and signs txs.
# Required in every mode. Use a throwaway test wallet — never commit a real seed
# phrase. On a local Yaci devnet any throwaway wallet works; `create` tops it up
# from the faucet automatically.
MNEMONIC=
