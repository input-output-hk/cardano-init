// Package config reads the project's environment and wires up an Apollo
// chain context and wallet from it.
//
// The choice of chain backend follows the shared ../.env, which is the
// project's connection seam. This code never names the component that wrote
// it; it only looks at which keys are set:
//
//   - YACI_ADMIN_URL, or INDEXER_URL without OGMIOS_URL: a Blockfrost-compatible
//     indexer (a local Yaci DevKit devnet, or Dingo). No project id needed.
//   - OGMIOS_URL: Ogmios, with Kupo at INDEXER_URL for UTxO queries.
//   - DOLOS_GRPC_URL: Dolos over UTxO RPC.
//   - none of the above: public Blockfrost, which needs BLOCKFROST_PROJECT_ID.
package config

import (
	"bufio"
	"bytes"
	"encoding/json"
	"fmt"
	"net/http"
	"os"
	"strings"
	"time"

	apollo "github.com/Salvionied/apollo/v2"
	"github.com/Salvionied/apollo/v2/backend"
	"github.com/Salvionied/apollo/v2/backend/blockfrost"
	"github.com/Salvionied/apollo/v2/backend/ogmios"
	"github.com/Salvionied/apollo/v2/backend/utxorpc"
	"github.com/Salvionied/apollo/v2/constants"
	"github.com/blinklabs-io/bursa"

	"{{ project_name }}/off-chain/giftcard"
)

// Provider kinds, one per chain backend.
const (
	Indexer    = "indexer"    // Blockfrost-compatible local indexer (Yaci, Dingo)
	Kupmios    = "kupmios"    // Ogmios + Kupo
	UtxoRpc    = "utxorpc"    // Dolos
	Blockfrost = "blockfrost" // public Blockfrost
)

// Provider says how to reach the chain.
type Provider struct {
	Kind string
	// URL is the indexer, Blockfrost, Ogmios, or UTxO RPC endpoint.
	URL string
	// KupoURL is set for Kupmios.
	KupoURL string
	// ProjectID is the Blockfrost project id (public Blockfrost only).
	ProjectID string
	// AdminURL is the Yaci DevKit admin API, used for the devnet faucet.
	AdminURL string
}

// Env is the resolved configuration.
type Env struct {
	// Network is preview, preprod, or mainnet.
	Network   string
	NetworkID uint8
	Provider  Provider
	Mnemonic  string
}

var blockfrostURLs = map[string]string{
	"preview": constants.BlockfrostBaseUrlPreview,
	"preprod": constants.BlockfrostBaseUrlPreprod,
	"mainnet": constants.BlockfrostBaseUrlMainnet,
}

// DefaultEnvFiles are read by Load, in order: the shared project .env (network
// and connection details), then the gitignored .env.local for secrets.
var DefaultEnvFiles = []string{"../.env", ".env.local", ".env"}

// Load reads the given dotenv files (DefaultEnvFiles if none) without
// overriding variables already set in the process environment, then resolves
// the configuration. It returns the names of any missing required settings.
func Load(files ...string) (Env, []string) {
	if len(files) == 0 {
		files = DefaultEnvFiles
	}
	for _, f := range files {
		LoadDotenv(f)
	}

	get := func(k string) string { return strings.TrimSpace(os.Getenv(k)) }
	var missing []string

	network := get("CARDANO_NETWORK")
	if network == "" {
		network = "preview"
	}
	if _, ok := blockfrostURLs[network]; !ok {
		missing = append(missing, "CARDANO_NETWORK (one of preview|preprod|mainnet)")
		network = "preview"
	}
	networkID := uint8(0)
	if network == "mainnet" {
		networkID = 1
	}

	indexer, admin := get("INDEXER_URL"), get("YACI_ADMIN_URL")
	ogmiosURL, dolosURL := get("OGMIOS_URL"), get("DOLOS_GRPC_URL")

	var p Provider
	switch {
	case admin != "" || (indexer != "" && ogmiosURL == ""):
		p = Provider{Kind: Indexer, URL: indexer, AdminURL: admin}
		if indexer == "" {
			missing = append(missing, "INDEXER_URL (YACI_ADMIN_URL is set, but the devnet indexer is not)")
		}
	case ogmiosURL != "":
		p = Provider{Kind: Kupmios, URL: ogmiosURL, KupoURL: indexer}
	case dolosURL != "":
		p = Provider{Kind: UtxoRpc, URL: dolosURL}
	default:
		p = Provider{Kind: Blockfrost, URL: blockfrostURLs[network], ProjectID: get("BLOCKFROST_PROJECT_ID")}
		if p.ProjectID == "" {
			missing = append(missing, "BLOCKFROST_PROJECT_ID (or start a local devnet: INDEXER_URL)")
		}
	}

	mnemonic := get("MNEMONIC")
	if mnemonic == "" {
		missing = append(missing, "MNEMONIC")
	}
	return Env{Network: network, NetworkID: networkID, Provider: p, Mnemonic: mnemonic}, missing
}

// LoadDotenv sets KEY=VALUE pairs from a dotenv file into the process
// environment, skipping keys that are already set. A missing file is ignored.
func LoadDotenv(path string) {
	raw, err := os.ReadFile(path)
	if err != nil {
		return
	}
	sc := bufio.NewScanner(bytes.NewReader(raw))
	for sc.Scan() {
		line := strings.TrimSpace(sc.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		key, value, ok := strings.Cut(strings.TrimPrefix(line, "export "), "=")
		if !ok {
			continue
		}
		key = strings.TrimSpace(key)
		value = strings.Trim(strings.TrimSpace(value), `"'`)
		if _, set := os.LookupEnv(key); !set {
			os.Setenv(key, value)
		}
	}
}

// ChainContext builds the Apollo chain backend for the configured provider.
func ChainContext(env Env) (backend.ChainContext, error) {
	p := env.Provider
	switch p.Kind {
	case Indexer:
		// Yaci and Dingo ignore the project id.
		return blockfrost.NewBlockFrostChainContext(p.URL, env.NetworkID, ""), nil
	case Kupmios:
		return ogmios.NewOgmiosChainContext(ogmios.Config{
			OgmiosEndpoint: p.URL,
			KupoEndpoint:   p.KupoURL,
			NetworkId:      env.NetworkID,
		})
	case UtxoRpc:
		return utxorpc.NewUtxoRpcChainContext(p.URL, env.NetworkID, nil), nil
	case Blockfrost:
		return blockfrost.NewBlockFrostChainContext(p.URL, env.NetworkID, p.ProjectID), nil
	}
	return nil, fmt.Errorf("unknown provider kind %q", p.Kind)
}

// Wallet derives the signing wallet (account 0, address 0) from MNEMONIC.
func Wallet(env Env) (*apollo.BursaWallet, error) {
	return apollo.NewBursaWallet(env.Mnemonic, bursa.WithNetwork(env.Network))
}

// Contract wires up a chain context, a wallet, and a GiftCard contract that
// uses the bundled blueprint.
func Contract(env Env) (*giftcard.Contract, *apollo.BursaWallet, error) {
	cc, err := ChainContext(env)
	if err != nil {
		return nil, nil, err
	}
	w, err := Wallet(env)
	if err != nil {
		return nil, nil, err
	}
	c, err := giftcard.New(cc, env.NetworkID)
	if err != nil {
		return nil, nil, err
	}
	return c, w, nil
}

// Topup funds addr with ada (whole ADA) from the Yaci DevKit faucet. It does
// nothing and returns false unless a Yaci admin API is configured.
func Topup(env Env, addr string, ada int) (bool, error) {
	if env.Provider.AdminURL == "" {
		return false, nil
	}
	body, _ := json.Marshal(map[string]any{"address": addr, "adaAmount": ada})
	url := strings.TrimRight(env.Provider.AdminURL, "/") + "/local-cluster/api/addresses/topup"
	client := &http.Client{Timeout: 30 * time.Second}
	res, err := client.Post(url, "application/json", bytes.NewReader(body))
	if err != nil {
		return false, fmt.Errorf("devnet faucet: %w", err)
	}
	defer res.Body.Close()
	if res.StatusCode/100 != 2 {
		return false, fmt.Errorf("devnet faucet: HTTP %d", res.StatusCode)
	}
	return true, nil
}
