{ inputs, pkgs, lib }:

pkgs.haskell-nix.cabalProject' {
  name = "{{ project_name }}";

  compiler-nix-name = lib.mkDefault "ghc966";

  src = lib.cleanSource ../.;

  inputMap = { "https://chap.intersectmbo.org/" = inputs.CHaP; };

  # Skip Haddock for every dependency; it roughly doubles the first build.
  modules = [{ doHaddock = false; }];
}
