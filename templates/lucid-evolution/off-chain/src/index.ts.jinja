// Library entry point. Re-exports the framework-agnostic core so the package
// can be imported from a backend or a frontend:
//
//   import { GiftCardContract, getGiftCardValidators } from "{{ project_name }}-off-chain";
//
// Node-only helpers (reading configuration from the environment, building a
// Lucid Evolution instance with a mnemonic wallet) live behind the
// "{{ project_name }}-off-chain/node" subpath so they never reach a browser
// bundle. `createGiftCard` / `redeemGiftCard` return unsigned transactions, so
// a backend can build with a read-only wallet
// (`lucid.selectWallet.fromAddress(userAddress, utxos)`) and leave signing to
// the user's wallet; a frontend uses `lucid.selectWallet.fromAPI(walletApi)`.
export * from "./contract.js";
