-- Plutus packages come from IOG's package repository (CHaP).
repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

-- Must be new enough to contain the plutus-core version Plutarch pins
-- (1.71.0.0 for Plutarch 1.15.0). Bump together with the Plutarch tag below.
index-state:
  , hackage.haskell.org 2026-09-29T22:14:46Z
  , cardano-haskell-packages 2026-09-29T22:14:46Z

packages:
  ./.

-- Plutarch is not published to Hackage or CHaP, so it is pulled from its git
-- repository, pinned to the v1.15.0 release commit. The --sha256 line lets
-- the Nix build (haskell.nix) fetch it reproducibly; plain cabal ignores it.
source-repository-package
  type: git
  location: https://github.com/Plutonomicon/plutarch-plutus
  tag: 84f02d544c10d67084c8a0e304758ec8cfbc5dd7
  --sha256: 07n97ji79rnxnjpbfq69q9hpff9k1b13d9gn4mgbpjghg8mza7gg
  subdir:
    .
    plutarch-ledger-api

tests: True
test-show-details: direct
