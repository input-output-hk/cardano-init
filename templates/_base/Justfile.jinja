# {{ project_name }} — Cardano protocol project
# Generated by cardano-init. Edit freely.
#
# The top level aggregates the tasks that terminate and compose: build, test,
# clean. Long-running / interactive tasks (watch modes, local devnets, REPLs)
# are per-component and optional — a component exposes `dev` only when it has
# such a mode. Run one directly, e.g. `just -f <dir>/Justfile dev`; list a
# component's targets with `just -f <dir>/Justfile --list`. See README.md.

default:
    @just --list
{%- if has_fullstack %}

# --- Protocol ({{ fullstack.tool_name }}, fullstack: on-chain + off-chain) ---
# One component produces the blueprint AND builds transactions.
build-protocol:
    @echo '{{ "{{BOLD + CYAN}}▶ protocol · building · " }}{{ fullstack.tool_name }}{{ "{{NORMAL}}" }}'
    @just -f {{ fullstack.dir }}/Justfile build

test-protocol:
    @echo '{{ "{{BOLD + CYAN}}▶ protocol · testing · " }}{{ fullstack.tool_name }}{{ "{{NORMAL}}" }}'
    @just -f {{ fullstack.dir }}/Justfile test
{%- endif %}
{%- if has_on_chain %}

# --- On-chain ({{ on_chain.tool_name }}) ---
build-on-chain:
    @echo '{{ "{{BOLD + CYAN}}▶ on-chain · building · " }}{{ on_chain.tool_name }}{{ "{{NORMAL}}" }}'
    @just -f {{ on_chain.dir }}/Justfile build

test-on-chain:
    @echo '{{ "{{BOLD + CYAN}}▶ on-chain · testing · " }}{{ on_chain.tool_name }}{{ "{{NORMAL}}" }}'
    @just -f {{ on_chain.dir }}/Justfile test
{%- endif %}
{%- if has_off_chain %}

# --- Off-chain ({{ off_chain.tool_name }}) ---
build-off-chain:
    @echo '{{ "{{BOLD + CYAN}}▶ off-chain · building · " }}{{ off_chain.tool_name }}{{ "{{NORMAL}}" }}'
    @just -f {{ off_chain.dir }}/Justfile build

test-off-chain:
    @echo '{{ "{{BOLD + CYAN}}▶ off-chain · testing · " }}{{ off_chain.tool_name }}{{ "{{NORMAL}}" }}'
    @just -f {{ off_chain.dir }}/Justfile test
{%- endif %}
{%- if has_infra %}

# --- Infrastructure (cardano-up) ---
# Provision the local stack (long-running): `just -f infra/Justfile dev`.
build-infra:
    @echo '{{ "{{BOLD + CYAN}}▶ infrastructure · building{{NORMAL}}" }}'
    @just -f infra/Justfile build

test-infra:
    @echo '{{ "{{BOLD + CYAN}}▶ infrastructure · testing{{NORMAL}}" }}'
    @just -f infra/Justfile test
{%- endif %}
{%- if has_devnet %}

# --- Devnet ({{ devnet.tool_name }}) ---
test-integration:
    @echo '{{ "{{BOLD + CYAN}}▶ devnet · integration test · " }}{{ devnet.tool_name }}{{ "{{NORMAL}}" }}'
    @just -f {{ devnet.dir }}/Justfile test
{%- endif %}
{%- if has_formal_methods %}

# --- Formal methods ({{ formal_methods.tool_name }}) ---
verify:
    @echo '{{ "{{BOLD + CYAN}}▶ formal-methods · verifying · " }}{{ formal_methods.tool_name }}{{ "{{NORMAL}}" }}'
    @just -f {{ formal_methods.dir }}/Justfile test
{%- endif %}

# --- Aggregate tasks ---
build:
{%- if has_fullstack %} build-protocol{% endif %}
{%- if has_on_chain %} build-on-chain{% endif %}
{%- if has_off_chain %} build-off-chain{% endif %}
{%- if has_infra %} build-infra{% endif %}
    @echo '{{ "{{BOLD + GREEN}}✓ Build complete{{NORMAL}}" }}'

# Build the blueprint first (consumers read ../blueprint/plutus.json), then run
# each component's tests in role order. A fullstack `protocol` component is the
# blueprint producer, so it builds and tests first.
test:
{%- if has_fullstack %} build-protocol test-protocol{% endif %}
{%- if has_on_chain %} build-on-chain test-on-chain{% endif %}
{%- if has_off_chain %} test-off-chain{% endif %}
{%- if has_infra %} test-infra{% endif %}
{%- if has_devnet %} test-integration{% endif %}
{%- if has_formal_methods %} verify{% endif %}
    @echo '{{ "{{BOLD + BLACK + BG_GREEN}}  ✓  All tests passed  {{NORMAL}}" }}'

clean:
{%- if has_fullstack %}
    just -f {{ fullstack.dir }}/Justfile clean
{%- endif %}
{%- if has_on_chain %}
    just -f {{ on_chain.dir }}/Justfile clean
{%- endif %}
{%- if has_off_chain %}
    just -f {{ off_chain.dir }}/Justfile clean
{%- endif %}
{%- if has_infra %}
    just -f infra/Justfile clean
{%- endif %}
{%- if has_devnet %}
    just -f {{ devnet.dir }}/Justfile clean
{%- endif %}
{%- if has_formal_methods %}
    just -f {{ formal_methods.dir }}/Justfile clean
{%- endif %}
    rm -f {{ blueprint_path }}
    @echo '{{ "{{BOLD + GREEN}}✓ Clean complete{{NORMAL}}" }}'
