# Off-chain component (Scalus) — transaction building
# Part of {{ project_name }}
#
# Builds and submits gift-card create/redeem transactions with Scalus's
# TxBuilder (UTxO selection, collateral, and balancing are automatic). The
# validators are taken from the interface-contract blueprint at
# ../{{ blueprint_path }} — this component parameterises whatever contract the
# on-chain tool produced, so build an on-chain component first. Where
# transactions go is decided by the shared ../.env — this component never names
# the tool that wrote it:
#   • INDEXER_URL set (a local devnet, e.g. Yaci DevKit's `just dev`) → that
#     devnet, with its built-in test wallet. No Blockfrost key needed.
#   • INDEXER_URL absent → Blockfrost (needs BLOCKFROST_API_KEY + MNEMONIC in
#     .env.local — see .env.example).

# Compile the off-chain sources.
build:
    @sbt compile

# Emulator tests of the create/redeem flow — no blockchain, milliseconds per
# test. They parameterise the blueprint's validators, so they run only once an
# on-chain component has produced ../{{ blueprint_path }} (skipped otherwise).
test:
    @sbt test

# Run the gift-card REST API against whatever ../.env points at (local devnet or
# Blockfrost). Swagger UI at http://localhost:8088/docs. Long-running: Ctrl-C.
dev:
    sbt "runMain app.start"

clean:
    @sbt clean
